# Build artifacts
*.AppImage
*.msi
*.exe
# AI assistant / agent working directories - local tooling state, not app code.
# These change on every session and must never be published.
#   .mnemon/  dsh-mneme's project memory (SQLite DB + notes + user preferences)
.dsh-vision-toolkit/
.workbuddy/
.mnemon/

# SQLite sidecar files, created next to any .db at runtime
*.db-shm
*.db-wal

# Generated by scripts/sign_updater.py during the Release workflow.
# The committed copy went stale (it pinned an older version and dead asset
# URLs), so it is not tracked: the app fetches it from the latest release.
updater.json
